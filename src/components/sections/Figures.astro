---
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'
import { getFigures } from '@/content/figures'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const figures = getFigures(lang)

const isRed = (suit: string) => suit === '♥' || suit === '♦'
---

<section id="figures" class="scroll-mt-[70px]">
  <SectionHeader kicker={t('figures.label')} title={t('figures.title')} />

  <div
    class="grid grid-cols-2 max-[1080px]:grid-cols-1 gap-8 max-w-[1000px] max-[1080px]:max-w-[640px] mx-auto px-12 pt-10 pb-8 max-[760px]:px-6 max-[760px]:pt-8"
  >
    {
      figures.map((figure) => (
        <article
          class="relative text-left p-[30px_30px_26px] bg-card-bg border-2 border-red rounded-2xl shadow-[0_10px_26px_rgba(43,33,24,.14)] transition-transform duration-[180ms] ease-in-out hover:-translate-y-[5px] motion-reduce:transition-none"
          aria-label={figure.company}
        >
          {/* Coin haut-gauche */}
          <div
            class={`card-corner corner-tl font-ui font-bold text-[22px] leading-[1.05] text-center${isRed(figure.suit) ? ' text-red' : ' text-ink'}`}
            aria-hidden="true"
          >
            <span class="block">{figure.rank}</span>
            <span class="block">{figure.suit}</span>
          </div>

          {/* Contenu */}
          <h3 class="font-logo text-[23px] leading-[1.2] text-ink mt-[34px] mb-1">
            {figure.company}
          </h3>
          <p class="font-serif text-[12px] text-red tracking-[1.5px] uppercase m-0">
            {figure.years} · {figure.mission}
          </p>
          <p class="font-serif text-[13.5px] leading-[1.65] text-[#4a3d30] mt-[14px] mb-4">
            {figure.description}
          </p>

          <ul class="list-none m-0 p-0" role="list">
            {figure.achievements.map((item) => (
              <li class="flex gap-[10px] items-baseline py-[5px]">
                <span class="text-red text-[13px] shrink-0" aria-hidden="true">
                  {figure.suit}
                </span>
                <span class="font-ui text-[12.5px] text-[#4a3d30] leading-[1.5]">{item}</span>
              </li>
            ))}
          </ul>

          {/* Coin bas-droit */}
          <div
            class={`card-corner corner-br font-ui font-bold text-[22px] leading-[1.05] text-center${isRed(figure.suit) ? ' text-red' : ' text-ink'}`}
            aria-hidden="true"
          >
            <span class="block">{figure.rank}</span>
            <span class="block">{figure.suit}</span>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Seul le positionnement absolu des coins ne peut pas être exprimé proprement en Tailwind */
  .card-corner {
    position: absolute;
  }
  .corner-tl {
    top: 14px;
    left: 16px;
  }
  .corner-br {
    bottom: 14px;
    right: 16px;
    transform: rotate(180deg);
  }
</style>
