---
import { useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'
import { getProfileContent } from '@/content/profile'

interface Props {
  lang: Lang
  topPadding?: string
}

const { lang, topPadding = 'pt-[10px]' } = Astro.props
const t = useTranslations(lang)
const profileContent = getProfileContent(lang)
---

<div class={`max-w-[700px] mx-auto px-12 ${topPadding} pb-[70px] text-center max-[760px]:px-6`}>
  <p class="font-ui font-semibold text-[13px] uppercase tracking-[4px] text-red mb-5">
    {t('about.formation.label')}
  </p>
  <div>
    {
      profileContent.formations.map((f) => (
        <p class="font-serif text-[14px] text-[#5c4d3d] py-[7px] m-0">
          {f.degree} — {f.school} ({f.period})
        </p>
      ))
    }
  </div>
</div>
