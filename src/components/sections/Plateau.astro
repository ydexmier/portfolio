---
import SectionHeader from '@/components/ui/SectionHeader.astro'
import { useTranslations } from '@/i18n/utils'
import type { Lang } from '@/i18n/ui'
import { getPlateau } from '@/content/plateau'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
const plateau = getPlateau(lang)

const isRed = (suit: string) => suit === '♥' || suit === '♦'
---

<section id="plateau" class="plateau-section">
  <SectionHeader
    kicker={t('plateau.label')}
    title={t('plateau.title')}
    subtitle={t('plateau.subtitle')}
  />

  <div class="plateau-grid">
    {
      plateau.map((item, i) => {
        if (item.variant === 'empty') {
          return (
            <div class="case case-empty">
              <span class="case-number" aria-hidden="true">
                {i + 1}
              </span>
              <p class="empty-text">{t('plateau.empty')}</p>
            </div>
          )
        }

        return (
          <div class={`case${item.variant === 'featured' ? ' case-featured' : ''}`}>
            <span class="case-number" aria-hidden="true">
              {i + 1}
            </span>
            {item.hasPion && (
              <span class="pion" aria-label="Position actuelle" role="img">
                📍
              </span>
            )}

            <div class="card" role="article" aria-label={item.company}>
              {/* Coin haut-gauche */}
              <div
                class={`card-corner corner-tl${isRed(item.suit) ? ' red' : ''}`}
                aria-hidden="true"
              >
                <span class="corner-rank">{item.rank}</span>
                <span class="corner-suit">{item.suit}</span>
              </div>

              {/* Contenu */}
              <div class="card-body">
                <h3 class="card-company">{item.company}</h3>
                <p class="card-period">{item.period}</p>
                <p class="card-description">{item.description}</p>
              </div>

              {/* Coin bas-droit */}
              <div
                class={`card-corner corner-br${isRed(item.suit) ? ' red' : ''}`}
                aria-hidden="true"
              >
                <span class="corner-rank">{item.rank}</span>
                <span class="corner-suit">{item.suit}</span>
              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</section>

<style>
  .plateau-section {
    scroll-margin-top: 70px;
  }

  /* ── Grille ── */
  .plateau-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 48px 30px;
  }

  /* ── Case conteneur ── */
  .case {
    position: relative;
    display: flex;
    padding: 13px;
    border-radius: 18px;
    background: #efe6d5;
    border: 1.5px solid #ddd0b8;
  }

  .case-featured {
    background: #e9d9c2;
    border-color: #c9a86b;
  }

  .case-empty {
    border-style: dashed;
    background: transparent;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  /* ── Pastille numéro ── */
  .case-number {
    position: absolute;
    top: -14px;
    left: 16px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #2b2118;
    color: #f7f2e9;
    font-family: 'Archivo Variable', ui-sans-serif, sans-serif;
    font-weight: 700;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  /* ── Pion ── */
  .pion {
    position: absolute;
    top: -22px;
    right: 14px;
    font-size: 26px;
    z-index: 2;
    line-height: 1;
  }

  /* ── Carte ── */
  .card {
    flex: 1;
    display: flex;
    flex-direction: column;
    text-align: left;
    background: #fffdf8;
    border: 1px solid #d8cbb6;
    border-radius: 12px;
    padding: 16px 16px 14px;
    min-height: 186px;
    position: relative;
    box-shadow: 0 5px 14px rgba(43, 33, 24, 0.1);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }

  .card:hover {
    transform: translateY(-6px) rotate(-1deg);
    box-shadow: 0 14px 26px rgba(43, 33, 24, 0.18);
    cursor: pointer;
  }

  /* ── Coins de carte ── */
  .card-corner {
    position: absolute;
    font-family: 'Archivo Variable', ui-sans-serif, sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.05;
    text-align: center;
    color: #2b2118;
  }

  .card-corner.red {
    color: #8e3b2f;
  }

  .corner-tl {
    top: 9px;
    left: 11px;
  }

  .corner-br {
    bottom: 9px;
    right: 11px;
    transform: rotate(180deg);
  }

  .corner-rank,
  .corner-suit {
    display: block;
  }

  /* ── Contenu texte ── */
  .card-body {
    flex: 1;
  }

  .card-company {
    font-family: 'Young Serif', Georgia, serif;
    font-size: 15.5px;
    line-height: 1.2;
    color: #2b2118;
    margin: 28px 0 4px;
  }

  .card-period {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 11px;
    color: #8e3b2f;
    letter-spacing: 1px;
    margin: 0;
  }

  .card-description {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 12px;
    line-height: 1.55;
    color: #5c4d3d;
    margin: 8px 0 0;
  }

  /* ── Case vide ── */
  .empty-text {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    color: #8e3b2f;
    margin: 0;
    text-align: center;
  }

  /* ── Responsive ── */
  @media (max-width: 1080px) {
    .plateau-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .plateau-grid {
      grid-template-columns: 1fr;
      padding: 36px 22px 24px;
      gap: 30px;
    }
  }

  /* ── Accessibilité ── */
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
